{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "ui-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_UI_PREVIEW": "true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ENABLE_UI_PREVIEW": "false"
      }
    }
  }
}
